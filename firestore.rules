rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function sup() { return request.auth != null && request.auth.token.email == 'ryan.trisyardi@gmail.com'; }
    function fam(f) { return get(/databases/$(db)/documents/families/$(f)).data; }
    function mem(f) { return request.auth.uid in fam(f).uids; }
    function mrole(f) { return fam(f).members[request.auth.uid].role; }
    function myemail() { return request.auth.token.email.lower(); }
    function inv(f) { return exists(/databases/$(db)/documents/invites/$(myemail() + '|' + f)); }

    match /invites/{id} {
      allow read: if request.auth != null && (sup() || resource.data.email == myemail()
                     || (mem(resource.data.fid) && mrole(resource.data.fid) == 'admin'));
      allow create, update: if request.auth != null && mem(request.resource.data.fid)
                     && mrole(request.resource.data.fid) == 'admin';
      allow delete: if request.auth != null && (sup() || resource.data.email == myemail()
                     || (mem(resource.data.fid) && mrole(resource.data.fid) == 'admin'));
    }
    match /families/{f} {
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid
                     && request.auth.uid in request.resource.data.uids;
      allow read: if request.auth != null && (sup() || request.auth.uid in resource.data.uids || inv(f));
      allow update: if request.auth != null && (sup() || inv(f)
                     || (request.auth.uid in resource.data.uids && resource.data.members[request.auth.uid].role == 'admin'));
      allow delete: if request.auth != null && (sup() || resource.data.owner == request.auth.uid);
      match /r/{id} {
        allow read: if request.auth != null && (sup() || mem(f));
        allow write: if request.auth != null && (sup() || (mem(f) && mrole(f) != 'viewer'));
      }
    }
  }
}
