rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function sup() { return request.auth != null && request.auth.token.email == 'ryan.trisyardi@gmail.com'; }
    function fam(f) { return get(/databases/$(db)/documents/families/$(f)).data; }
    function mem(f) { return request.auth.uid in fam(f).members; }
    function adm(f) { return fam(f).members[request.auth.uid].role == 'admin'; }
    function inv(f) {
      return exists(/databases/$(db)/documents/invites/$(request.auth.token.email.lower())) &&
             get(/databases/$(db)/documents/invites/$(request.auth.token.email.lower())).data.fid == f;
    }
    match /users/{u} {
      allow read, write: if request.auth != null && (request.auth.uid == u || sup());
      allow delete: if request.auth != null && adm(resource.data.fid);
    }
    match /invites/{m} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && adm(request.resource.data.fid);
      allow delete: if request.auth != null && (sup() || adm(resource.data.fid));
    }
    match /families/{f} {
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow read: if request.auth != null && (sup() || request.auth.uid in resource.data.members || inv(f));
      allow update: if request.auth != null && (sup() || adm(f) || inv(f));
      match /r/{id} {
        allow read: if request.auth != null && (sup() || mem(f));
        allow write: if request.auth != null && (sup() || (mem(f) && fam(f).members[request.auth.uid].role != 'viewer'));
      }
    }
  }
}
